AGENT_ENVIRONMENT=development
# 默认保持真实服务模式；本地联调使用 make mock，不要给前端配置任何私有密钥。
AGENT_MOCK_MODE=false
# 独立随机生成两份 >=32 字符的值；绝不能交给前端。
AGENT_SERVICE_API_KEY=
AGENT_JWT_SECRET=
AGENT_INTEGRATION_APP_ID=education-platform
AGENT_TOKEN_TTL_SECONDS=900
AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/agent.db
AGENT_CORS_ORIGINS=["http://localhost:5173"]

# Nacos 3.2+，使用客户端 API 端口（不是 8080 控制台端口）。
AGENT_NACOS_URL=http://127.0.0.1:8848
AGENT_NACOS_NAMESPACE=student-game-agent
AGENT_NACOS_USERNAME=nacos
AGENT_NACOS_PASSWORD=
AGENT_NACOS_AUTH_ENABLED=true
# 如果使用已有短期访问令牌可填写；到期需更新，优先配置专用账号。
AGENT_NACOS_ACCESS_TOKEN=
AGENT_BASE_PROMPT_KEY=companion.base
AGENT_BASE_PROMPT_VERSION=1.0.0
AGENT_CHAT_PROMPT_KEY=companion.chat
AGENT_CHAT_PROMPT_VERSION=1.0.0
AGENT_EVALUATION_PROMPT_KEY=companion.evaluation
AGENT_EVALUATION_PROMPT_VERSION=1.0.0
# 可选：启动时预热公共模板，不预加载所有游戏；失败后业务请求仍按需获取。
AGENT_PROMPT_PREWARM=false

# LiteLLM 或兼容 API；填写已在模型网关配置好的模型别名。
AGENT_LLM_BASE_URL=http://127.0.0.1:4000/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_RAG_ENABLED=false

# 可选：每局结束自动评价需要真实的权威数据接口。
# Worker 调用 GET {URL}/attempts/{source_attempt_id}?revision={source_revision}
AGENT_ATTEMPT_API_URL=
AGENT_ATTEMPT_API_KEY=
AGENT_JOB_MAX_ATTEMPTS=5
AGENT_JOB_LEASE_SECONDS=300

# 仅 Compose PostgreSQL 使用；另生成随机值，避免 URL 特殊字符。
POSTGRES_PASSWORD=
