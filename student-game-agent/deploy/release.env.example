# Server-only file: /project/fengyucode-student-agent/.pipeline/agent.env (chmod 600).
# Generate each value separately; no production credential defaults.
POSTGRES_PASSWORD=
AGENT_SERVICE_API_KEY=
AGENT_JWT_SECRET=
AGENT_NACOS_URL=http://your-private-nacos:8848
AGENT_NACOS_NAMESPACE=student-game-agent
AGENT_NACOS_USERNAME=
AGENT_NACOS_PASSWORD=
AGENT_LLM_BASE_URL=https://your-model-gateway/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=
AGENT_ATTEMPT_API_URL=
AGENT_ATTEMPT_API_KEY=

# Online demonstration uses AGENT_DEMO_RESPONSES=true in the versioned release .env.
# Set the GitHub Actions variable AGENT_DEMO_RESPONSES=false after real model/prompt setup.
# This is a release setting, not a secret; setting it here does not override release .env.
# AGENT_MOCK_MODE stays false in production: no dev bootstrap or fixed mock student.
