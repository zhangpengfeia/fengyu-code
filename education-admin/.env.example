# Copy to .env for docker compose. Real .env files are ignored by Git.
EDU_DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-redis-password
EDU_ADMIN_PASSWORD=replace-with-a-unique-admin-password
EDU_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Trusted internal games use the same origin; /play/ is protected by the API.
EDU_ADMIN_ORIGIN=https://fengyucode.zhangff.cn
EDU_GAME_ORIGIN=https://fengyucode.zhangff.cn
EDU_EXTERNAL_HOSTS=
EDU_SECURE_GAME_COOKIE=true
EDU_PORT=18090
