# Repository root is the build context, so the existing planet source is available.
FROM node:22-bookworm-slim AS games
WORKDIR /src/gamesoptionproject
COPY gamesoptionproject/package*.json ./
RUN npm ci --no-audit --no-fund
COPY gamesoptionproject/ ./
RUN GAME_BASE_PATH=/play/planet/ npm run build
FROM maven:3.9.9-eclipse-temurin-17 AS backend
WORKDIR /src
COPY education-admin/backend/ ./
RUN mvn -B -ntp -DskipTests package
FROM eclipse-temurin:17-jre
WORKDIR /app
RUN groupadd --system education && useradd --system --gid education --home-dir /app education && mkdir -p /app/.runtime && chown -R education:education /app
COPY --from=backend /src/ruoyi-admin/target/ruoyi-admin.jar /app/app.jar
COPY education-admin/games/number-match/ /games/number-match/
COPY --from=games /src/gamesoptionproject/dist/ /games/planet/v1/
COPY education-admin/games/planet/manifest.json /games/planet/v1/manifest.json
USER education
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
