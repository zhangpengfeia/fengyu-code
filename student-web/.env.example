# Only public browser configuration belongs in VITE_* variables.
VITE_EDUCATION_API_BASE=/education-api
VITE_AGENT_API_BASE=/agent-api
VITE_BASE_PATH=/
# Optional education-backend endpoint that returns {access_token, expires_in}.
# Leave empty until the platform implements the Agent token bridge.
VITE_AGENT_TOKEN_ENDPOINT=
EDUCATION_API_TARGET=http://127.0.0.1:8081
AGENT_API_TARGET=http://127.0.0.1:8088
# Only used by npm run dev:mock; no credentials belong here.
MOCK_AGENT_API_TARGET=http://127.0.0.1:8088
