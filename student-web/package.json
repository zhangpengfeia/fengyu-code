{
  "name": "fengyu-student-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:preview": "vite --host 127.0.0.1 --mode preview",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "build": "vue-tsc --noEmit && vite build",
    "build:preview": "vue-tsc --noEmit && vite build --mode preview",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:mock": "node scripts/smoke-mock.mjs"
  },
  "dependencies": {
    "axios": "1.13.2",
    "echarts": "5.6.0",
    "pinia": "3.0.4",
    "vant": "^4.9.21",
    "vue": "3.5.26",
    "vue-router": "4.6.4",
    "@fengyu/agent-widget-sdk": "file:../agent-widget-sdk"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "less": "^4.9.1",
    "typescript": "~5.8.3",
    "vite": "6.4.1",
    "vue-tsc": "^2.2.12",
    "tsx": "^4.20.6"
  }
}
